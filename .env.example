# Server port
PORT=3001

# Allowed CORS origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Path to ffprobe binary (leave empty to use system PATH)
FFPROBE_PATH=

# Path to ffmpeg binary (leave empty to use system PATH)
FFMPEG_PATH=

# HLS VOD Configuration
HLS_SEGMENT_DURATION=6
HLS_SESSION_TTL_MINUTES=30
HLS_TEMP_DIR=
MAX_ACTIVE_SESSIONS=10
MAX_CONCURRENT_FFMPEG_PROCESSES=5

